{
  "name": "action-update-version",
  "version": "1.0.1",
  "description": "Update package version field on new releases",
  "main": "lib/main.js",
  "scripts": {
    "build": "tsc && yarn run package",
    "lint": "eslint src --ext .tsx,.js,.ts",
    "lint:fix": "yarn lint --fix",
    "package": "ncc build --source-map --license licenses.txt",
    "test": "jest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qxip/action-version-update.git"
  },
  "keywords": [
    "actions",
    "version",
    "release",
    "update",
    "tag"
  ],
  "author": "Victor Navarro <victor@vnavarro.com>",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.10.0",
    "@actions/exec": "1.0.4",
    "@actions/github": "^6.0.0",
    "glob": "^8.0.3",
    "yaml": "1.10.3"
  },
  "resolutions": {
    "braces": "3.0.3",
    "flatted": "3.4.2",
    "js-yaml": "3.15.2",
    "json5": "1.0.2",
    "lodash": "4.18.1",
    "**/minimatch": "3.1.3",
    "glob/minimatch": "5.1.8",
    "**/cross-spawn/semver": "5.7.2",
    "tmp": "0.2.6",
    "@babel/runtime": "7.26.10",
    "@octokit/plugin-paginate-rest": "9.2.2",
    "@octokit/request-error": "5.1.1",
    "@octokit/request": "8.4.1",
    "picomatch": "2.3.2",
    "uuid": "11.1.1",
    "yaml": "1.10.3"
  },
  "overrides": {
    "minimatch@3": {
      ".": "3.1.3",
      "brace-expansion": "1.1.16"
    },
    "minimatch@5": {
      ".": "5.1.8",
      "brace-expansion": "2.1.7"
    },
    "braces": "3.0.3",
    "flatted": "3.4.2",
    "js-yaml": "3.15.2",
    "json5": "1.0.2",
    "lodash": "4.18.1",
    "semver@5": "5.7.2",
    "tmp": "0.2.6",
    "@babel/runtime": "7.26.10",
    "@octokit/plugin-paginate-rest": "9.2.2",
    "@octokit/request-error": "5.1.1",
    "@octokit/request": "8.4.1",
    "picomatch": "2.3.2",
    "uuid": "11.1.1",
    "yaml": "1.10.3"
  },
  "devDependencies": {
    "@pocket-apps/eslint-config": "3.0.0",
    "@types/glob": "^8.0.0",
    "@types/node": "14.11.2",
    "@typescript-eslint/eslint-plugin": "4.1.0",
    "@typescript-eslint/parser": "4.1.0",
    "@vercel/ncc": "0.24.1",
    "eslint": "6.8.0",
    "eslint-config-airbnb": "18.2.0",
    "eslint-plugin-cypress": "2.11.2",
    "eslint-plugin-import": "2.22.0",
    "eslint-plugin-jest": "23.20.0",
    "eslint-plugin-jsx-a11y": "6.3.1",
    "eslint-plugin-react": "7.21.3",
    "eslint-plugin-react-hooks": "4.1.2",
    "eslint-plugin-replace-relative-imports": "^1.0.0",
    "eslint-plugin-unused-imports": "0.1.3",
    "husky": "^4.3.8",
    "lint-staged": "10.2.13",
    "typescript": "^4.0.2"
  },
  "eslintConfig": {
    "extends": [
      "@pocket-apps/eslint-config"
    ]
  },
  "husky": {
    "hooks": {
      "pre-push": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{ts,js,tsx}": [
      "yarn lint:fix",
      "yarn lint"
    ]
  }
}
